---
interface Props { title: string; lead?: string; crumbs?: { href: string; label: string }[]; eyebrow?: string }
const { title, lead, crumbs = [], eyebrow } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Você está em">
      <a href="/">Início</a>
      {crumbs.map((c) => <><span class="sep">/</span><a href={c.href}>{c.label}</a></>)}
      <span class="sep">/</span><span aria-current="page">{title}</span>
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
