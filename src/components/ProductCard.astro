---
import { productUrl, type Product } from '../lib/data';
interface Props { product: Product; categoryName?: string }
const { product: p, categoryName } = Astro.props;
---
<a class="card" href={productUrl(p)} data-category={p.category} data-brand={p.brand} data-specialties={p.specialties.join(' ')}>
  <div class="card-media stage">
    {p.images[0] ? <img src={p.images[0]} alt={p.name} loading="lazy" /> : <span class="placeholder">{p.brand}</span>}
  </div>
  <div class="card-body">
    <span class="tag">{p.brand}{categoryName ? ` · ${categoryName}` : ''}</span>
    <h3>{p.name}</h3>
    {p.summary && <p>{p.summary.length > 110 ? p.summary.slice(0, 107).trimEnd() + '…' : p.summary}</p>}
    <span class="link-more">Conheça</span>
  </div>
</a>
