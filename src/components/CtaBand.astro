---
import { getSite, whatsappLink } from '../lib/data';
interface Props { title?: string; text?: string; message?: string }
const { title = 'Vamos encontrar o equipamento certo para a sua instituição?', text = 'Fale com o nosso time comercial e receba uma proposta sob medida.', message } = Astro.props;
const site = await getSite();
---
<section class="section cta-section">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-white" href="/contato/#cotacao">Solicitar cotação</a>
        <a class="btn btn-outline-white" href={whatsappLink(site, message ?? 'Olá! Vim pelo site e gostaria de uma cotação.')} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta-section { padding-block: 24px 96px; }
</style>
