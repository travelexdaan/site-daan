---
import '../styles/global.css';
import { getSite, getCategoryTree, getSpecialties, getBrands, whatsappLink } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
}
const { title, description = 'Equipamentos de diagnóstico por imagem Philips, Konica Minolta e Guerbet para clínicas e hospitais no Paraná. Venda, consultoria e pós-venda.', image } = Astro.props;
const site = await getSite();
const tree = await getCategoryTree();
const specialties = await getSpecialties();
const brands = await getBrands();
const fullTitle = title === 'Daan Imagem' ? 'Daan Imagem | Diagnóstico por imagem no Paraná' : `${title} | Daan Imagem`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isActive = (prefix: string) => (prefix === '/' ? path === '/' : path.startsWith(prefix));
const year = new Date().getFullYear();
const tel = (n: string) => `tel:+55${n.replace(/\D/g, '')}`;
const brandList = brands.filter((b) => b.featured).map((b) => b.name).join(', ').replace(/, ([^,]*)$/, ' e $1');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#00875a" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />
    {site.gtm && (
      <script is:inline define:vars={{ gtm: site.gtm }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
      </script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'Daan Imagem',
      url: 'https://www.daanimagem.com.br',
      telephone: site.phone,
      email: site.email,
      address: { '@type': 'PostalAddress', streetAddress: site.address, addressLocality: 'Curitiba', addressRegion: 'PR', addressCountry: 'BR' },
      sameAs: [site.instagram, site.linkedin].filter(Boolean),
    })} />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar-inner">
        <span>{site.hours}</span>
        <span class="topbar-links">
          <a href={whatsappLink(site)} target="_blank" rel="noopener">WhatsApp {site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.instagram && <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>}
          {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
        </span>
      </div>
    </div>
    <header class="header" id="header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Daan Imagem, página inicial"><img src={site.logo} alt="Daan Imagem" width="170" height="38" /></a>
        <nav id="nav" class="nav" aria-label="Principal">
          <ul>
            <li class="has-sub">
              <a href="/equipamentos/" class:list={{ active: isActive('/equipamentos') }}>Equipamentos</a>
              <div class="sub mega">
                {tree.map((c) => (
                  <div class="mega-col">
                    <a class="sub-title" href={`/equipamentos/${c.slug}/`}>{c.name}</a>
                    {c.children.map((s) => <a href={`/equipamentos/${c.slug}/${s.slug}/`}>{s.name}</a>)}
                  </div>
                ))}
              </div>
            </li>
            <li class="has-sub">
              <a href="/especialidades/" class:list={{ active: isActive('/especialidades') }}>Especialidades</a>
              <div class="sub">
                {specialties.map((s) => <a href={`/especialidades/${s.slug}/`}>{s.name}</a>)}
              </div>
            </li>
            <li class="has-sub">
              <a href="/marcas/" class:list={{ active: isActive('/marcas') }}>Marcas</a>
              <div class="sub">
                {brands.map((b) => <a href={`/marcas/${b.slug}/`}>{b.name}</a>)}
              </div>
            </li>
            <li><a href="/pos-venda/" class:list={{ active: isActive('/pos-venda') }}>Pós-venda</a></li>
            <li><a href="/sobre-nos/" class:list={{ active: isActive('/sobre-nos') }}>Sobre</a></li>
            <li><a href="/blog/" class:list={{ active: isActive('/blog') }}>Blog</a></li>
            <li><a href="/contato/" class:list={{ active: isActive('/contato') }}>Contato</a></li>
          </ul>
          <a class="btn btn-primary nav-cta" href="/contato/#cotacao">Solicitar cotação</a>
        </nav>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav" aria-label="Abrir menu">
          <span></span><span></span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <img src={site.logo} alt="Daan Imagem" width="170" height="38" class="footer-logo" />
            <p>Representante autorizado {brandList} em diagnóstico por imagem no Paraná.</p>
            <div class="social">
              {site.instagram && <a href={site.instagram} target="_blank" rel="noopener">Instagram ↗</a>}
              {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
            </div>
          </div>
          <div>
            <h4>Equipamentos</h4>
            {tree.map((c) => <a href={`/equipamentos/${c.slug}/`}>{c.name}</a>)}
          </div>
          <div>
            <h4>Daan</h4>
            <a href="/sobre-nos/">Sobre nós</a>
            <a href="/marcas/">Marcas</a>
            <a href="/especialidades/">Especialidades</a>
            <a href="/pos-venda/">Pós-venda</a>
            <a href="/blog/">Blog</a>
          </div>
          <div class="footer-contact">
            <h4>Contato</h4>
            <a href={whatsappLink(site)} target="_blank" rel="noopener">WhatsApp {site.phone}</a>
            <a href={tel(site.mobile)}>{site.mobile}</a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <p>{site.address}</p>
            <p>{site.hours}</p>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} Daan Imagem. Todos os direitos reservados.</span>
          <a href="/privacidade/">Política de privacidade</a>
        </div>
      </div>
    </footer>

    <a class="whats-float" href={whatsappLink(site, 'Olá! Vim pelo site e gostaria de falar com a equipe comercial.')} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.8 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.3z"/></svg>
    </a>

    <script>
      const header = document.getElementById('header');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.getElementById('nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
        document.body.classList.toggle('nav-open', !open);
      });
    </script>
  </body>
</html>

<style is:global>
  .topbar { background: var(--green-700); color: rgba(255,255,255,.8); font-size: .84rem; }
  .topbar-inner { display: flex; justify-content: space-between; gap: 16px; padding-block: 8px; }
  .topbar a { color: #fff; text-decoration: none; margin-left: 22px; }
  .topbar a:hover { text-decoration: underline; }
  .header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid var(--line); transition: box-shadow .3s; }
  .header.scrolled { box-shadow: 0 6px 24px rgba(22,37,31,.08); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 86px; }
  .logo img { height: 44px; width: auto; }
  .nav { display: flex; align-items: center; gap: 18px; }
  .nav ul { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; }
  .nav li { position: relative; }
  .nav > ul > li > a { display: block; padding: 10px 12px; color: var(--ink); text-decoration: none; font-family: var(--font-display); font-weight: 500; font-size: .93rem; position: relative; }
  .nav > ul > li > a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 2px; height: 2px; background: var(--green); transform: scaleX(0); transition: transform .2s; }
  .nav > ul > li > a:hover, .nav > ul > li > a.active { color: var(--green); }
  .nav > ul > li > a:hover::after, .nav > ul > li > a.active::after { transform: scaleX(1); }
  .nav-cta { padding: 12px 20px; }
  .sub { position: absolute; top: 100%; left: 0; min-width: 240px; background: #fff; border-radius: 10px; border-top: 3px solid var(--green); box-shadow: var(--shadow); padding: 10px; opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .2s, transform .2s, visibility .2s; }
  .sub a { display: block; padding: 8px 12px; color: var(--text); text-decoration: none; border-radius: 6px; font-size: .93rem; }
  .sub a:hover { background: var(--green-50); color: var(--green); }
  .sub.mega { display: grid; grid-template-columns: repeat(3, minmax(170px, 1fr)); gap: 4px 16px; min-width: 640px; left: -60px; padding: 20px; }
  .sub .sub-title { font-family: var(--font-display); font-weight: 600; color: var(--ink); }
  .has-sub:hover > .sub, .has-sub:focus-within > .sub { opacity: 1; visibility: visible; transform: none; }
  .menu-toggle { display: none; background: var(--green-50); border: 0; width: 46px; height: 46px; border-radius: 8px; cursor: pointer; padding: 0 13px; }
  .menu-toggle span { display: block; height: 2px; background: var(--green-700); margin: 6px 0; transition: transform .2s; }
  .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(4px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-4px) rotate(-45deg); }

  .footer { background: var(--green-700); color: rgba(255,255,255,.72); padding-top: 80px; font-size: .95rem; }
  .footer-top { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.4fr; gap: 40px; }
  .footer h4 { color: #fff; font-size: 1rem; margin-bottom: 16px; }
  .footer a { display: block; color: rgba(255,255,255,.8); text-decoration: none; padding: 4px 0; }
  .footer a:hover { color: #fff; }
  .footer p { margin: 8px 0 0; }
  .footer-brand p { max-width: 320px; margin: 18px 0; }
  .footer-logo { filter: brightness(0) invert(1); height: 40px; width: auto; }
  .social { display: flex; gap: 20px; }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; border-top: 1px solid rgba(255,255,255,.14); margin-top: 56px; padding-block: 22px 26px; font-size: .84rem; }
  .footer-bottom a { padding: 0; }

  .whats-float { position: fixed; right: 22px; bottom: 22px; z-index: 60; width: 58px; height: 58px; border-radius: 50%; background: var(--whats); color: #fff; display: grid; place-items: center; box-shadow: 0 10px 30px rgba(0,0,0,.2); transition: transform .2s; }
  .whats-float:hover { transform: scale(1.06); }

  @media (max-width: 1100px) {
    .topbar { display: none; }
    .menu-toggle { display: block; }
    .header-inner { height: 72px; }
    .logo img { height: 38px; }
    .nav { position: fixed; inset: 72px 0 0 0; background: #fff; flex-direction: column; align-items: stretch; padding: 24px; gap: 20px; overflow-y: auto; display: none; }
    .nav.open { display: flex; }
    .nav ul { flex-direction: column; }
    .nav > ul > li > a { font-size: 1.1rem; padding: 14px 4px; border-bottom: 1px solid var(--line); }
    .nav > ul > li > a::after { display: none; }
    .sub, .sub.mega { display: none !important; }
    body.nav-open { overflow: hidden; }
    .footer-top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) { .footer-top { grid-template-columns: 1fr; } }
</style>
