---
import '../styles/global.css';
import { getSite, getCategoryTree, getSpecialties, whatsappLink } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
}
const { title, description = 'Equipamentos de diagnóstico por imagem Philips e Carestream para clínicas e hospitais no Paraná. Venda, consultoria e pós-venda.', image } = Astro.props;
const site = await getSite();
const tree = await getCategoryTree();
const specialties = await getSpecialties();
const fullTitle = title === 'Daan Imagem' ? title : `${title} | Daan Imagem`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isActive = (prefix: string) => (prefix === '/' ? path === '/' : path.startsWith(prefix));
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    {site.gtm && (
      <script is:inline define:vars={{ gtm: site.gtm }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
      </script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'Daan Imagem',
      url: 'https://www.daanimagem.com.br',
      telephone: site.phone,
      email: site.email,
      address: { '@type': 'PostalAddress', streetAddress: site.address, addressLocality: 'Curitiba', addressRegion: 'PR', addressCountry: 'BR' },
      sameAs: [site.instagram, site.linkedin].filter(Boolean),
    })} />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar-inner">
        <span>{site.hours}</span>
        <span class="topbar-links">
          <a href={`tel:+55${site.phone.replace(/\D/g, '')}`}>{site.phone}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </span>
      </div>
    </div>
    <header class="header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Daan Imagem, página inicial"><img src={site.logo} alt="Daan Imagem" width="180" height="40" /></a>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav" aria-label="Abrir menu">
          <span></span><span></span><span></span>
        </button>
        <nav id="nav" class="nav" aria-label="Principal">
          <ul>
            <li><a href="/sobre-nos/" class:list={{ active: isActive('/sobre-nos') }}>Sobre</a></li>
            <li class="has-sub">
              <a href="/equipamentos/" class:list={{ active: isActive('/equipamentos') }}>Equipamentos</a>
              <div class="sub mega">
                {tree.map((c) => (
                  <div>
                    <a class="sub-title" href={`/equipamentos/${c.slug}/`}>{c.name}</a>
                    {c.children.map((s) => <a href={`/equipamentos/${c.slug}/${s.slug}/`}>{s.name}</a>)}
                  </div>
                ))}
              </div>
            </li>
            <li class="has-sub">
              <a href="/especialidades/" class:list={{ active: isActive('/especialidades') }}>Especialidades</a>
              <div class="sub">
                {specialties.map((s) => <a href={`/especialidades/${s.slug}/`}>{s.name}</a>)}
              </div>
            </li>
            <li><a href="/pos-venda/" class:list={{ active: isActive('/pos-venda') }}>Pós-venda</a></li>
            <li><a href="/blog/" class:list={{ active: isActive('/blog') }}>Blog</a></li>
            <li><a href="/contato/" class:list={{ active: isActive('/contato') }}>Contato</a></li>
          </ul>
          <a class="btn btn-primary nav-cta" href="/contato/#cotacao">Solicitar cotação</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <img src={site.logo} alt="Daan Imagem" width="180" height="40" class="footer-logo" />
          <p>Representante autorizado Philips e Carestream em diagnóstico por imagem no Paraná.</p>
          <div class="social">
            {site.instagram && <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>}
            {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
          </div>
        </div>
        <div>
          <h4>Equipamentos</h4>
          {tree.map((c) => <a href={`/equipamentos/${c.slug}/`}>{c.name}</a>)}
        </div>
        <div>
          <h4>Institucional</h4>
          <a href="/sobre-nos/">Sobre nós</a>
          <a href="/especialidades/">Especialidades</a>
          <a href="/pos-venda/">Pós-venda</a>
          <a href="/blog/">Blog</a>
          <a href="/privacidade/">Privacidade</a>
        </div>
        <div>
          <h4>Contato</h4>
          <a href={`tel:+55${site.phone.replace(/\D/g, '')}`}>{site.phone}</a>
          <a href={whatsappLink(site)} target="_blank" rel="noopener">WhatsApp {site.phone}</a>
          <a href={`tel:+55${site.mobile.replace(/\D/g, '')}`}>{site.mobile}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <p>{site.address}</p>
          <p>{site.hours}</p>
        </div>
      </div>
      <div class="container footer-bottom">© {year} Daan Imagem. Todos os direitos reservados.</div>
    </footer>

    <a class="whats-float" href={whatsappLink(site, 'Olá! Vim pelo site e gostaria de falar com a equipe comercial.')} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.8 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.3z"/></svg>
    </a>

    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.getElementById('nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
        document.body.classList.toggle('nav-open', !open);
      });
    </script>
  </body>
</html>

<style is:global>
  .topbar { background: var(--navy); color: rgba(255,255,255,.85); font-size: .82rem; }
  .topbar-inner { display: flex; justify-content: space-between; gap: 16px; padding-top: 8px; padding-bottom: 8px; }
  .topbar a { color: #fff; text-decoration: none; margin-left: 18px; }
  .header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.96); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; height: 76px; }
  .logo img { height: 40px; width: auto; }
  .nav { display: flex; align-items: center; gap: 24px; }
  .nav ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .nav li { position: relative; }
  .nav > ul > li > a { display: block; padding: 10px 12px; color: var(--ink); text-decoration: none; font-weight: 500; border-radius: 8px; }
  .nav > ul > li > a:hover, .nav > ul > li > a.active { color: var(--blue); background: var(--bg-soft); }
  .sub { position: absolute; top: 100%; left: 0; min-width: 240px; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); padding: 10px; display: none; }
  .sub a { display: block; padding: 7px 10px; color: var(--ink); text-decoration: none; border-radius: 6px; font-size: .93rem; }
  .sub a:hover { background: var(--bg-soft); color: var(--blue); }
  .sub.mega { display: none; grid-template-columns: repeat(3, minmax(180px, 1fr)); gap: 8px 16px; min-width: 640px; left: -160px; padding: 18px; }
  .sub .sub-title { font-weight: 700; color: var(--navy); }
  .has-sub:hover > .sub, .has-sub:focus-within > .sub { display: block; }
  .has-sub:hover > .sub.mega, .has-sub:focus-within > .sub.mega { display: grid; }
  .menu-toggle { display: none; background: none; border: 0; padding: 8px; cursor: pointer; }
  .menu-toggle span { display: block; width: 24px; height: 2px; background: var(--navy); margin: 5px 0; }

  .footer { background: var(--navy); color: rgba(255,255,255,.75); margin-top: 0; padding-top: 56px; font-size: .93rem; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.3fr; gap: 32px; }
  .footer h4 { color: #fff; font-size: 1rem; margin-bottom: 12px; }
  .footer a { display: block; color: rgba(255,255,255,.8); text-decoration: none; padding: 3px 0; }
  .footer a:hover { color: #fff; }
  .footer-logo { filter: brightness(0) invert(1); height: 36px; width: auto; margin-bottom: 14px; }
  .social { display: flex; gap: 16px; }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,.12); margin-top: 40px; padding-top: 18px; padding-bottom: 24px; font-size: .82rem; }

  .whats-float { position: fixed; right: 20px; bottom: 20px; z-index: 60; width: 58px; height: 58px; border-radius: 50%; background: var(--green); color: #fff; display: grid; place-items: center; box-shadow: 0 8px 24px rgba(0,0,0,.2); }

  @media (max-width: 960px) {
    .topbar { display: none; }
    .menu-toggle { display: block; }
    .nav { position: fixed; inset: 76px 0 0 0; background: #fff; flex-direction: column; align-items: stretch; padding: 20px; gap: 16px; overflow-y: auto; display: none; }
    .nav.open { display: flex; }
    .nav ul { flex-direction: column; }
    .sub, .sub.mega { position: static; display: none !important; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
    body.nav-open { overflow: hidden; }
  }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
