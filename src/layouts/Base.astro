---
import '../styles/global.css';
import { getSite, getCategoryTree, getSpecialties, getBrands, whatsappLink } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
}
const { title, description = 'Equipamentos de diagnóstico por imagem Philips, Konica Minolta e Guerbet para clínicas e hospitais no Paraná. Venda, consultoria e pós-venda.', image } = Astro.props;
const site = await getSite();
const tree = await getCategoryTree();
const specialties = await getSpecialties();
const brands = await getBrands();
const fullTitle = title === 'Daan Imagem' ? 'Daan Imagem | Diagnóstico por imagem no Paraná' : `${title} | Daan Imagem`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isActive = (prefix: string) => (prefix === '/' ? path === '/' : path.startsWith(prefix));
const year = new Date().getFullYear();
const tel = (n: string) => `tel:+55${n.replace(/\D/g, '')}`;
const brandList = brands.filter((b) => b.featured).map((b) => b.name).join(', ').replace(/, ([^,]*)$/, ' e $1');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#07162b" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&family=Sora:wght@500;600;700&display=swap" rel="stylesheet" />
    {site.gtm && (
      <script is:inline define:vars={{ gtm: site.gtm }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
      </script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'Daan Imagem',
      url: 'https://www.daanimagem.com.br',
      telephone: site.phone,
      email: site.email,
      address: { '@type': 'PostalAddress', streetAddress: site.address, addressLocality: 'Curitiba', addressRegion: 'PR', addressCountry: 'BR' },
      sameAs: [site.instagram, site.linkedin].filter(Boolean),
    })} />
  </head>
  <body>
    <header class="header" id="header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Daan Imagem, página inicial"><img src={site.logo} alt="Daan Imagem" width="170" height="38" /></a>
        <nav id="nav" class="nav" aria-label="Principal">
          <ul>
            <li class="has-sub">
              <a href="/equipamentos/" class:list={{ active: isActive('/equipamentos') }}>Equipamentos</a>
              <div class="sub mega">
                {tree.map((c) => (
                  <div class="mega-col">
                    <a class="sub-title" href={`/equipamentos/${c.slug}/`}>{c.name}</a>
                    {c.children.map((s) => <a href={`/equipamentos/${c.slug}/${s.slug}/`}>{s.name}</a>)}
                  </div>
                ))}
              </div>
            </li>
            <li class="has-sub">
              <a href="/especialidades/" class:list={{ active: isActive('/especialidades') }}>Especialidades</a>
              <div class="sub">
                {specialties.map((s) => <a href={`/especialidades/${s.slug}/`}>{s.name}</a>)}
              </div>
            </li>
            <li class="has-sub">
              <a href="/marcas/" class:list={{ active: isActive('/marcas') }}>Marcas</a>
              <div class="sub">
                {brands.map((b) => <a href={`/marcas/${b.slug}/`}>{b.name}</a>)}
              </div>
            </li>
            <li><a href="/pos-venda/" class:list={{ active: isActive('/pos-venda') }}>Pós-venda</a></li>
            <li><a href="/sobre-nos/" class:list={{ active: isActive('/sobre-nos') }}>Sobre</a></li>
            <li><a href="/blog/" class:list={{ active: isActive('/blog') }}>Blog</a></li>
            <li><a href="/contato/" class:list={{ active: isActive('/contato') }}>Contato</a></li>
          </ul>
          <a class="btn btn-cyan nav-cta" href="/contato/#cotacao">Solicitar cotação</a>
        </nav>
        <button class="menu-toggle" aria-expanded="false" aria-controls="nav" aria-label="Abrir menu">
          <span></span><span></span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <img src={site.logo} alt="Daan Imagem" width="170" height="38" class="footer-logo" />
            <p>Representante autorizado {brandList} em diagnóstico por imagem no Paraná.</p>
            <div class="social">
              {site.instagram && <a href={site.instagram} target="_blank" rel="noopener">Instagram ↗</a>}
              {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
            </div>
          </div>
          <div>
            <h4>Equipamentos</h4>
            {tree.map((c) => <a href={`/equipamentos/${c.slug}/`}>{c.name}</a>)}
          </div>
          <div>
            <h4>Daan</h4>
            <a href="/sobre-nos/">Sobre nós</a>
            <a href="/marcas/">Marcas</a>
            <a href="/especialidades/">Especialidades</a>
            <a href="/pos-venda/">Pós-venda</a>
            <a href="/blog/">Blog</a>
          </div>
          <div class="footer-contact">
            <h4>Contato</h4>
            <a href={whatsappLink(site)} target="_blank" rel="noopener">WhatsApp {site.phone}</a>
            <a href={tel(site.mobile)}>{site.mobile}</a>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <p>{site.address}</p>
            <p>{site.hours}</p>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {year} Daan Imagem. Todos os direitos reservados.</span>
          <a href="/privacidade/">Política de privacidade</a>
        </div>
      </div>
    </footer>

    <a class="whats-float" href={whatsappLink(site, 'Olá! Vim pelo site e gostaria de falar com a equipe comercial.')} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.6c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.8 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.6-.3z"/></svg>
    </a>

    <script>
      const header = document.getElementById('header');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.getElementById('nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
        document.body.classList.toggle('nav-open', !open);
      });
    </script>
  </body>
</html>

<style is:global>
  .header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; transition: background 0.3s, box-shadow 0.3s; }
  .header::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(7, 22, 43, 0.7), rgba(7, 22, 43, 0)); pointer-events: none; transition: opacity 0.3s; }
  .header.scrolled { background: rgba(7, 22, 43, 0.88); backdrop-filter: saturate(140%) blur(14px); -webkit-backdrop-filter: saturate(140%) blur(14px); box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08); }
  .header.scrolled::before { opacity: 0; }
  .header-inner { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 84px; }
  .logo img { height: 36px; width: auto; filter: brightness(0) invert(1); }
  .nav { display: flex; align-items: center; gap: 16px; }
  .nav ul { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; }
  .nav li { position: relative; }
  .nav > ul > li > a { display: block; padding: 10px 12px; color: rgba(255, 255, 255, 0.82); text-decoration: none; font-weight: 500; font-size: 0.95rem; border-radius: 999px; transition: color 0.2s, background 0.2s; }
  .nav > ul > li > a:hover, .nav > ul > li > a.active { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .nav-cta { padding: 11px 20px; font-size: 0.93rem; }
  .sub {
    position: absolute; top: calc(100% + 10px); left: 0; min-width: 240px; background: #fff; border-radius: 16px; box-shadow: var(--shadow-lg);
    padding: 10px; opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  .sub::before { content: ''; position: absolute; top: -12px; left: 0; right: 0; height: 12px; }
  .sub a { display: block; padding: 8px 12px; color: var(--text); text-decoration: none; border-radius: 8px; font-size: 0.93rem; }
  .sub a:hover { background: var(--bg-soft); color: var(--blue); }
  .sub.mega { display: grid; grid-template-columns: repeat(4, minmax(150px, 1fr)); gap: 6px 12px; min-width: 720px; left: -40px; padding: 20px; }
  .sub .sub-title { font-family: var(--font-display); font-weight: 600; color: var(--ink); }
  .has-sub:hover > .sub, .has-sub:focus-within > .sub { opacity: 1; visibility: visible; transform: none; }
  .menu-toggle { display: none; background: rgba(255, 255, 255, 0.1); border: 0; width: 46px; height: 46px; border-radius: 50%; cursor: pointer; padding: 0 13px; }
  .menu-toggle span { display: block; height: 2px; background: #fff; margin: 6px 0; transition: transform 0.2s; }
  .menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(4px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-4px) rotate(-45deg); }

  .footer { background: var(--ink); color: rgba(255, 255, 255, 0.62); padding-top: 88px; font-size: 0.95rem; }
  .footer-top { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.4fr; gap: 40px; }
  .footer h4 { color: #fff; font-size: 0.95rem; margin-bottom: 16px; }
  .footer a { display: block; color: rgba(255, 255, 255, 0.72); text-decoration: none; padding: 4px 0; }
  .footer a:hover { color: #fff; }
  .footer p { margin: 8px 0 0; }
  .footer-brand p { max-width: 320px; margin: 18px 0; }
  .footer-logo { filter: brightness(0) invert(1); height: 34px; width: auto; }
  .social { display: flex; gap: 20px; }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; border-top: 1px solid var(--line-dark); margin-top: 64px; padding-block: 24px 28px; font-size: 0.84rem; }
  .footer-bottom a { padding: 0; }

  .whats-float { position: fixed; right: 22px; bottom: 22px; z-index: 60; width: 58px; height: 58px; border-radius: 50%; background: var(--green); color: #fff; display: grid; place-items: center; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25); transition: transform 0.2s; }
  .whats-float:hover { transform: scale(1.06); }

  @media (max-width: 1100px) {
    .menu-toggle { display: block; }
    .header-inner { height: 72px; }
    .nav { position: fixed; inset: 72px 0 0 0; background: var(--ink); flex-direction: column; align-items: stretch; padding: 24px; gap: 20px; overflow-y: auto; display: none; }
    .nav.open { display: flex; }
    .nav ul { flex-direction: column; }
    .nav > ul > li > a { font-size: 1.15rem; padding: 14px 12px; border-radius: 12px; }
    .sub, .sub.mega { display: none !important; }
    body.nav-open .header { background: var(--ink); }
    body.nav-open { overflow: hidden; }
    .footer-top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) { .footer-top { grid-template-columns: 1fr; } }
</style>
