---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getHome, getSite, getProducts, getCategoryTree, getSpecialties, getPosts, getBrands, whatsappLink, formatDate, productUrl } from '../lib/data';

const home = await getHome();
const site = await getSite();
const products = await getProducts();
const tree = await getCategoryTree();
const specialties = await getSpecialties();
const brands = await getBrands();
const posts = (await getPosts()).slice(0, 3);
const catName = Object.fromEntries(tree.map((c) => [c.slug, c.name]));
const firstWithImage = (cat: string) => products.find((p) => p.category === cat && p.images[0]);
const brandOf = (c: (typeof tree)[number]) => brands.find((b) => b.slug === c.brand) ?? brands.find((b) => b.lines.includes(c.slug));

// Carrossel do topo: um equipamento de cada linha principal.
const slides = ['epiq-elite', 'ingenia-ambition', 'azurion-7', 'incisive-ct', 'zenition-50']
  .map((s) => products.find((p) => p.slug === s && p.images[0]))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const firstPerLine = tree.map((c) => firstWithImage(c.slug)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const featured = [...firstPerLine, ...products.filter((p) => p.images[0] && !firstPerLine.includes(p))].slice(0, 6);
const services = [
  { t: 'Venda e consultoria', d: 'Ajudamos a escolher a configuração certa de equipamento e software para a sua instituição.' },
  { t: 'Instalação e aplicação', d: 'Acompanhamento técnico na instalação e treinamento da equipe clínica.' },
  { t: 'Pós-venda', d: 'Assistência técnica, acessórios e atualizações em todo o Paraná.' },
];
const featuredBrands = brands.filter((b) => b.featured);
---
<Base title="Daan Imagem" image={slides[0]?.images[0]}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Representante autorizado no Paraná</span>
        <h1>{home.heroTitle}</h1>
        <p class="lead">{home.heroSubtitle}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/equipamentos/">Conheça as soluções</a>
          <a class="btn btn-outline" href={whatsappLink(site, 'Olá! Vim pelo site e gostaria de falar com a equipe comercial.')} target="_blank" rel="noopener">Falar no WhatsApp</a>
        </div>
      </div>
      {slides.length > 0 && (
        <div class="slider" data-slider>
          {slides.map((p, i) => (
            <a class:list={['slide', { active: i === 0 }]} href={productUrl(p)} aria-hidden={i === 0 ? undefined : 'true'} tabindex={i === 0 ? undefined : -1}>
              <img src={p.images[0]} alt={p.name} loading={i === 0 ? 'eager' : 'lazy'} />
              <span class="slide-caption"><small>{p.brand} · {catName[p.category]}</small><strong>{p.name}</strong></span>
            </a>
          ))}
          <div class="dots" role="tablist" aria-label="Equipamentos em destaque">
            {slides.map((p, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={p.name} data-dot={i}></button>)}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="brands-band" aria-label="Marcas representadas">
    <div class="container brands-inner">
      {featuredBrands.map((b) => (
        <a href={`/marcas/${b.slug}/`} class="brand-mark">{b.logo ? <img src={b.logo} alt={b.name} /> : b.name}</a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <div class="about-media stage">
        {home.aboutImage ? <img src={home.aboutImage} alt="Equipe Daan Imagem" loading="lazy" /> : slides[1] && <img src={slides[1].images[0]} alt="" loading="lazy" />}
      </div>
      <div>
        <span class="eyebrow">Conheça a Daan</span>
        <h2>Referência em diagnóstico por imagem no Paraná</h2>
        <p>{home.aboutText}</p>
        <div class="services">
          {services.map((s) => (
            <div class="service">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
        <a class="link-more" href="/sobre-nos/">Conheça mais</a>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Soluções</span>
        <h2>Equipamentos para cada modalidade</h2>
        <p class="lead">Linhas completas Philips, Konica Minolta, Guerbet e Carestream para clínicas e hospitais.</p>
      </div>
      <div class="grid grid-3">
        {tree.map((c) => {
          const img = firstWithImage(c.slug)?.images[0];
          const brand = brandOf(c);
          return (
            <a class="card line-card" href={`/equipamentos/${c.slug}/`}>
              <div class:list={['card-media', 'stage', { 'no-img': !img }]}>
                {img ? <img src={img} alt="" loading="lazy" /> : <span class="line-brand">{brand?.name}</span>}
              </div>
              <div class="card-body">
                <span class="tag">{brand?.name}</span>
                <h3>{c.name}</h3>
                <span class="link-more">Conheça</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="head-row">
          <div>
            <span class="eyebrow">Destaques</span>
            <h2>Equipamentos em destaque</h2>
          </div>
          <a class="btn btn-outline" href="/equipamentos/">Ver todos os equipamentos</a>
        </div>
        <div class="grid grid-3">
          {featured.map((p) => <ProductCard product={p} categoryName={catName[p.category]} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section-green">
    <div class="container spec-band">
      <div>
        <span class="eyebrow light">Especialidades</span>
        <h2>Soluções para a sua especialidade</h2>
        <p>Encontre os equipamentos indicados para a sua área de atuação.</p>
      </div>
      <div class="chips">
        {specialties.map((s) => <a class="chip chip-light" href={`/especialidades/${s.slug}/`}>{s.name}</a>)}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="head-row">
          <div>
            <span class="eyebrow">Notícias</span>
            <h2>Últimas novidades</h2>
          </div>
          <a class="btn btn-outline" href="/blog/">Ver todas</a>
        </div>
        <div class="grid grid-3">
          {posts.map((p) => (
            <a class="card" href={`/blog/${p.slug}/`}>
              {p.coverImage && <div class="card-media cover"><img src={p.coverImage} alt="" loading="lazy" /></div>}
              <div class="card-body">
                <span class="tag">{formatDate(p.date)}</span>
                <h3>{p.title}</h3>
                <span class="link-more">Ler notícia</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>

<script>
  const slider = document.querySelector<HTMLElement>('[data-slider]');
  if (slider) {
    const slides = [...slider.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let current = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('active', i === current);
        if (i === current) { s.removeAttribute('aria-hidden'); s.removeAttribute('tabindex'); } else { s.setAttribute('aria-hidden', 'true'); s.tabIndex = -1; }
      });
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === current)));
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => { if (!reduce && slides.length > 1) timer = window.setInterval(() => show(current + 1), 5000); };
    dots.forEach((d, i) => d.addEventListener('click', () => { window.clearInterval(timer); show(i); start(); }));
    slider.addEventListener('mouseenter', () => window.clearInterval(timer));
    slider.addEventListener('mouseleave', () => { window.clearInterval(timer); start(); });
    start();
  }
</script>

<style>
  .hero { background: linear-gradient(100deg, #fff 0%, #fff 38%, var(--green-50) 38%); padding-block: 72px 80px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 48px; align-items: center; }
  .hero-copy { min-width: 0; }
  .hero h1 { margin-bottom: 20px; font-size: clamp(2rem, 3.6vw, 3rem); }
  .hero .lead { margin-bottom: 32px; }
  .slider { position: relative; aspect-ratio: 1 / 0.82; max-width: 100%; }
  .slide { position: absolute; inset: 0; display: block; background: var(--green-50); opacity: 0; transition: opacity .8s ease; text-decoration: none; }
  .slide.active { opacity: 1; z-index: 1; }
  .slide img { width: 100%; height: 88%; object-fit: contain; mix-blend-mode: multiply; transform: scale(.97); transition: transform 5s ease; }
  .slide.active img { transform: scale(1); }
  .slide-caption { position: absolute; left: 0; bottom: 0; display: grid; gap: 2px; background: #fff; border-left: 4px solid var(--green); border-radius: 0 8px 8px 0; padding: 12px 18px; box-shadow: var(--shadow); }
  .slide-caption small { color: var(--muted); font-size: .8rem; }
  .slide-caption strong { font-family: var(--font-display); color: var(--ink); font-size: 1.05rem; }
  .dots { position: absolute; right: 0; bottom: 18px; display: flex; gap: 8px; z-index: 2; }
  .dots button { width: 10px; height: 10px; border-radius: 999px; border: 0; padding: 0; background: rgba(0,135,90,.25); cursor: pointer; transition: width .3s, background .3s; }
  .dots button[aria-selected='true'] { width: 28px; background: var(--green); }

  .brands-band { border-block: 1px solid var(--line); background: #fff; }
  .brands-inner { display: flex; justify-content: space-around; align-items: center; gap: 32px; flex-wrap: wrap; padding-block: 30px; }
  .brand-mark { font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; color: #8a9a93; text-decoration: none; letter-spacing: -.01em; transition: color .2s; }
  .brand-mark:hover { color: var(--green); }
  .brand-mark img { height: 36px; width: auto; filter: grayscale(1); opacity: .7; transition: filter .2s, opacity .2s; }
  .brand-mark:hover img { filter: none; opacity: 1; }

  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .about-media { border-radius: 16px; aspect-ratio: 5 / 4; max-width: 100%; }
  .about-media img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: normal; }
  .services { display: grid; gap: 4px; margin: 28px 0 24px; border-top: 1px solid var(--line); }
  .service { padding: 16px 0 14px 20px; border-bottom: 1px solid var(--line); position: relative; }
  .service::before { content: ''; position: absolute; left: 0; top: 22px; width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
  .service h3 { font-size: 1.02rem; margin-bottom: 2px; }
  .service p { margin: 0; color: var(--muted); font-size: .95rem; }

  .line-card .card-body { gap: 4px; }
  .line-card h3 { font-size: 1.3rem; }
  .no-img { background: var(--green-50); }
  .line-brand { font-family: var(--font-display); font-weight: 600; font-size: 1.6rem; color: var(--green); opacity: .55; }

  .spec-band { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: center; }
  .spec-band p { margin: 0; }
  .eyebrow.light { color: #a9e2c6; }
  .chip-light { background: transparent; border-color: rgba(255,255,255,.35); color: #fff; padding: 12px 22px; font-size: 1rem; }
  .chip-light:hover { background: #fff; border-color: #fff; color: var(--green-700); }

  @media (max-width: 960px) {
    .hero { background: var(--green-50); padding-block: 48px 56px; }
    .hero-grid, .about, .spec-band { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
