---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getHome, getSite, getProducts, getCategoryTree, getSpecialties, getPosts, getBrands, whatsappLink, formatDate, productUrl } from '../lib/data';

const home = await getHome();
const site = await getSite();
const products = await getProducts();
const tree = await getCategoryTree();
const specialties = await getSpecialties();
const brands = await getBrands();
const posts = (await getPosts()).slice(0, 3);
const catName = Object.fromEntries(tree.map((c) => [c.slug, c.name]));
const firstWithImage = (cat: string) => products.find((p) => p.category === cat && p.images[0]);
const heroProduct = products.find((p) => p.slug === 'epiq-elite') ?? products.find((p) => p.images[0]);
const firstPerLine = tree.map((c) => firstWithImage(c.slug)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const featured = [...firstPerLine, ...products.filter((p) => p.images[0] && !firstPerLine.includes(p))].slice(0, 6);
const brandOf = (cat: string) => { const c = tree.find((x) => x.slug === cat); return brands.find((b) => b.slug === c?.brand) ?? brands.find((b) => b.lines.includes(cat)); };
const steps = [
  { t: 'Consultoria', d: 'Entendemos o perfil da sua instituição e indicamos a configuração ideal de equipamento e software.' },
  { t: 'Proposta e negociação', d: 'Condições comerciais competitivas, com prazos e formas de pagamento sob medida.' },
  { t: 'Instalação e treinamento', d: 'Equipe técnica acompanha a instalação e o treinamento de aplicação da equipe clínica.' },
  { t: 'Pós-venda', d: 'Suporte técnico, acessórios e atualizações para o equipamento seguir produzindo.' },
];
const aboutImage = home.aboutImage;
---
<Base title="Daan Imagem" image={heroProduct?.images[0]}>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">Diagnóstico por imagem · Paraná</p>
        <h1>{home.heroTitle.replace(/\.$/, '')}<span class="dot">.</span></h1>
        <p class="lead">{home.heroSubtitle}</p>
        <div class="btn-row">
          <a class="btn btn-cyan" href="/equipamentos/">Conhecer equipamentos <span class="arrow">→</span></a>
          <a class="btn btn-ghost-light" href={whatsappLink(site, 'Olá! Vim pelo site e gostaria de falar com a equipe comercial.')} target="_blank" rel="noopener">Falar no WhatsApp</a>
        </div>
      </div>
      {heroProduct && (
        <a class="hero-visual reveal" href={productUrl(heroProduct)} style="animation-delay:.15s">
          <div class="screen viewfinder">
            <img src={heroProduct.images[0]} alt={heroProduct.name} />
            <span class="readout readout-tl mono">{catName[heroProduct.category]}</span>
            <span class="readout readout-br mono">{heroProduct.brand} · {heroProduct.name}</span>
          </div>
          <div class="float-card">
            <strong>Todo o Paraná</strong>
            <span>Atendimento comercial e técnico em todo o estado</span>
          </div>
        </a>
      )}
    </div>
    <div class="container">
      <div class="brands-strip">
        <span class="mono">Representante autorizado</span>
        <ul>
          {brands.filter((b) => b.featured).map((b) => <li><a href={`/marcas/${b.slug}/`}>{b.logo ? <img src={b.logo} alt={b.name} /> : b.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="head-row">
        <div>
          <p class="eyebrow">Portfólio</p>
          <h2>Soluções para cada modalidade de imagem</h2>
        </div>
        <a class="link-arrow" href="/equipamentos/">Ver catálogo completo →</a>
      </div>
      <div class="bento">
        {tree.map((c, i) => {
          const count = products.filter((p) => p.category === c.slug).length;
          const img = firstWithImage(c.slug)?.images[0];
          const brand = brandOf(c.slug);
          return (
            <a class:list={['tile', { 'tile-lg': i === 0, 'tile-wide': i >= 5, 'tile-noimg': !img }]} href={`/equipamentos/${c.slug}/`}>
              <div class="tile-text">
                <span class="mono">{brand?.name ?? ''}</span>
                <h3>{c.name}</h3>
                <span class="tile-count">{count > 0 ? `${count} ${count === 1 ? 'produto' : 'produtos'}` : 'Sob consulta'} →</span>
              </div>
              {img && <img src={img} alt="" loading="lazy" />}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-dark process">
    <div class="container">
      <div class="head-row">
        <div>
          <p class="eyebrow">Como trabalhamos</p>
          <h2>Do projeto ao pós-venda, com a mesma equipe</h2>
        </div>
        <p class="lead">{home.aboutText}</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-n mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section section-soft">
      <div class="container">
        <div class="head-row">
          <div>
            <p class="eyebrow">Destaques</p>
            <h2>Equipamentos em destaque</h2>
          </div>
          <a class="link-arrow" href="/equipamentos/">Ver todos →</a>
        </div>
        <div class="grid grid-3">
          {featured.map((p) => <ProductCard product={p} categoryName={catName[p.category]} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container specialties">
      <div>
        <p class="eyebrow">Especialidades</p>
        <h2>Equipamentos indicados para a sua área</h2>
        <p class="lead">Do consultório de ginecologia ao centro de hemodinâmica, ajudamos a escolher a tecnologia certa para cada especialidade.</p>
      </div>
      <ul class="spec-list">
        {specialties.map((s) => (
          <li><a href={`/especialidades/${s.slug}/`}><span>{s.name}</span><span class="arrow">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container about">
      {aboutImage && <div class="about-img"><img src={aboutImage} alt="Equipe Daan Imagem" loading="lazy" /></div>}
      <div>
        <p class="eyebrow">Sobre a Daan</p>
        <h2>Referência em diagnóstico por imagem no Paraná</h2>
        <ul class="check-list">
          {home.highlights.map((h) => <li>{h}</li>)}
          <li>Representante oficial {brands.filter((b) => b.featured).map((b) => b.name).join(', ').replace(/, ([^,]*)$/, ' e $1')}</li>
        </ul>
        <div class="btn-row" style="margin-top:32px">
          <a class="btn btn-primary" href="/sobre-nos/">Conheça a Daan <span class="arrow">→</span></a>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="head-row">
          <div>
            <p class="eyebrow">Blog</p>
            <h2>Novidades e lançamentos</h2>
          </div>
          <a class="link-arrow" href="/blog/">Ver blog →</a>
        </div>
        <div class="grid grid-3">
          {posts.map((p) => (
            <a class="card" href={`/blog/${p.slug}/`}>
              {p.coverImage && <div class="card-media cover"><img src={p.coverImage} alt="" loading="lazy" /></div>}
              <div class="card-body">
                <span class="tag">{formatDate(p.date)}</span>
                <h3>{p.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>

<style>
  .hero { position: relative; overflow: hidden; background: var(--ink); color: rgba(255,255,255,.75); padding-block: 150px 40px; }
  .hero-bg { position: absolute; inset: 0; }
  .hero-bg::before { content: ''; position: absolute; inset: 0;
    background: radial-gradient(700px 420px at 80% 30%, rgba(43,196,228,.22), transparent 70%), radial-gradient(600px 400px at 10% 90%, rgba(26,95,208,.4), transparent 70%); }
  .hero-bg::after { content: ''; position: absolute; inset: 0; opacity: .5;
    background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 56px 56px; mask-image: radial-gradient(ellipse at 60% 40%, #000 30%, transparent 75%); }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }
  .hero-copy { min-width: 0; }
  .hero h1 { color: #fff; font-size: clamp(2.2rem, 4.2vw, 3.6rem); margin-bottom: 24px; }
  .hero .dot { color: var(--cyan); }
  .hero .lead { color: rgba(255,255,255,.72); margin-bottom: 36px; }
  .hero-visual { position: relative; display: block; text-decoration: none; }
  .screen { position: relative; aspect-ratio: 5 / 4; max-width: 100%; border-radius: 28px; overflow: hidden;
    background: radial-gradient(90% 80% at 50% 60%, #1d3b66 0%, #0c2141 60%, #081a33 100%);
    border: 1px solid rgba(255,255,255,.1); box-shadow: 0 40px 80px rgba(0,0,0,.35); }
  .screen img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 36px; }
  .readout { position: absolute; color: var(--cyan); font-size: .7rem; z-index: 2; }
  .readout-tl { top: 20px; left: 46px; }
  .readout-br { bottom: 20px; right: 46px; }
  .float-card { position: absolute; left: -28px; bottom: 36px; background: #fff; color: var(--text); border-radius: 16px; padding: 16px 20px; box-shadow: var(--shadow-lg); display: grid; gap: 2px; max-width: 230px; }
  .float-card strong { font-family: var(--font-display); color: var(--ink); }
  .float-card span { font-size: .85rem; color: var(--muted); line-height: 1.4; }
  .brands-strip { position: relative; margin-top: 88px; padding-top: 28px; border-top: 1px solid var(--line-dark); display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
  .brands-strip .mono { color: rgba(255,255,255,.5); }
  .brands-strip ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 48px; flex-wrap: wrap; }
  .brands-strip a { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; color: #fff; text-decoration: none; opacity: .85; letter-spacing: -.01em; }
  .brands-strip a:hover { opacity: 1; color: var(--cyan); }
  .brands-strip img { height: 28px; width: auto; filter: brightness(0) invert(1); }

  .bento { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 230px; gap: 20px; }
  .tile { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--bg-soft); border: 1px solid var(--line); text-decoration: none; color: inherit; padding: 26px; display: flex; transition: box-shadow .25s, transform .25s; }
  .tile:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
  .tile-lg { grid-column: span 2; grid-row: span 2; background: linear-gradient(160deg, #eaf2fc, #f7fafd); }
  .tile-text { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 6px; max-width: 60%; }
  .tile-lg .tile-text { max-width: 100%; }
  .tile h3 { font-size: 1.35rem; margin: 0; }
  .tile-lg h3 { font-size: 2rem; }
  .tile .mono { color: var(--blue); }
  .tile-count { color: var(--muted); font-size: .92rem; font-weight: 500; margin-top: auto; }
  .tile-text { height: 100%; }
  .tile img { position: absolute; right: -6%; bottom: -4%; width: 62%; height: 78%; object-fit: contain; transition: transform .4s; }
  .tile-lg img { width: 82%; height: 70%; right: 2%; bottom: 4%; }
  .tile:hover img { transform: scale(1.05); }
  .tile-wide { grid-column: span 2; }
  .tile-noimg { background: var(--ink); border-color: var(--ink); }
  .tile-noimg h3 { color: #fff; }
  .tile-noimg .mono { color: var(--cyan); }
  .tile-noimg .tile-count { color: rgba(255,255,255,.7); }
  .tile-noimg .tile-text { max-width: 100%; }

  .process .head-row { align-items: start; }
  .process .lead { max-width: 480px; margin: 0; font-size: 1.05rem; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--line-dark); }
  .steps li { padding: 32px 28px 8px 0; position: relative; }
  .steps li + li { padding-left: 28px; border-left: 1px solid var(--line-dark); }
  .step-n { color: var(--cyan); display: block; margin-bottom: 18px; }
  .steps h3 { font-size: 1.2rem; }
  .steps p { font-size: .95rem; margin: 0; color: rgba(255,255,255,.65); }

  .specialties { display: grid; grid-template-columns: .9fr 1.1fr; gap: 64px; align-items: start; }
  .spec-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .spec-list a { display: flex; justify-content: space-between; align-items: center; padding: 20px 4px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); font-family: var(--font-display); font-size: 1.3rem; font-weight: 500; letter-spacing: -.01em; transition: padding .2s, color .2s; }
  .spec-list a:hover { color: var(--blue); padding-left: 14px; }
  .spec-list .arrow { color: var(--cyan); }

  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .about-img img { border-radius: 24px; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  @media (max-width: 980px) {
    .hero-grid, .specialties, .about { grid-template-columns: 1fr; gap: 40px; }
    .float-card { left: 16px; bottom: -20px; }
    .bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 200px; }
    .steps { grid-template-columns: 1fr 1fr; }
    .steps li:nth-child(3) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 600px) {
    .hero { padding-block: 116px 32px; }
    .bento { grid-template-columns: 1fr; grid-auto-rows: 180px; }
    .tile-lg { grid-column: auto; grid-row: span 2; }
    .tile-wide { grid-column: auto; }
    .steps { grid-template-columns: 1fr; }
    .steps li, .steps li + li { padding: 24px 0 8px; border-left: 0; }
    .brands-strip ul { gap: 28px; }
    .brands-strip { margin-top: 64px; }
  }
</style>
